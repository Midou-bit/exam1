{
  "scripts": {
    "start:notifications": "node --watch microservices/notifications/index.js",
    "start:stock-management": "node --watch microservices/stock-management/index.js",
    "start:gateway": "node --watch gateway/server.js",
    "start:backend": "node --watch backend/server.js",
    "start:frontend": "npm --prefix frontend start",
    "start:all": "npm-run-all --parallel start:notifications start:stock-management start:gateway start:backend start:frontend",
    "lint": "eslint backend gateway microservices",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10"
  }
}
