# Microservice notifications - copier en .env et renseigner les valeurs
NODE_ENV=
# Environnement affiché par /health : local, preprod ou prod (défaut local)
APP_ENV=
# Port d'écoute : PORT (Render) prioritaire, sinon NOTIFI_PORT (défaut 4002)
PORT=
NOTIFI_PORT=
# Compte Gmail expéditeur et mot de passe d'application
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=
# Niveau de log Winston (défaut info)
LOG_LEVEL=
# Clé interne partagée backend / gateway / microservices (en-tête x-internal-key)
INTERNAL_API_KEY=
