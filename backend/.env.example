# Backend (API Express) - copier en .env et renseigner les valeurs
NODE_ENV=
# Port d'écoute (imposé par Render ; défaut 5000)
PORT=
# Chaîne de connexion MongoDB (Atlas en préprod/prod)
MONGO_URI=
# Secret de signature des JWT
JWT_SECRET=
# URL de la gateway (défaut http://localhost:8000)
GATEWAY_URL=
# Destinataire des emails de nouvelle commande
NOTIFY_ADMIN_EMAIL=
# Origines autorisées, séparées par des virgules (défaut http://localhost:3000)
CORS_ORIGIN=
# Niveau de log Winston : error, warn, info, debug (défaut info)
LOG_LEVEL=
# Compte admin créé par "npm run seed"
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
