{
  "source": {
    "include": [
      "controllers",
      "middlewares",
      "validators",
      "config",
      "seeder.js",
      "logger.js",
      "server.js",
      "../gateway",
      "../microservices/notifications",
      "../microservices/stock-management"
    ],
    "includePattern": "\\.js$",
    "excludePattern": "(^|\\/|\\\\)(node_modules|logs|\\.venv)(\\/|\\\\)"
  },
  "recurseDepth": 3,
  "opts": {
    "destination": "../docs/api",
    "recurse": true,
    "encoding": "utf8",
    "readme": "../README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": { "cleverLinks": true, "default": { "includeDate": false } }
}
