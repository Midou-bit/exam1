# Gateway - copier en .env et renseigner les valeurs
NODE_ENV=
# Port d'écoute : PORT (Render) prioritaire, sinon GATEWAY_PORT (défaut 8000)
PORT=
GATEWAY_PORT=
# URLs des microservices (défauts http://localhost:4002 et http://localhost:4003)
NOTIFI_SERVICE_URL=
STOCK_SERVICE_URL=
# Non utilisée (proxy auth désactivé dans server.js)
AUTH_SERVICE_URL=
# Niveau de log Winston (défaut info)
LOG_LEVEL=
